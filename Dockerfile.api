FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    AD_MODELS_DIR=/app/models \
    AD_ALERT_DB=/app/data/alerts.db

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --upgrade pip && pip install -r requirements.txt

COPY src ./src
COPY scripts ./scripts
COPY pyproject.toml ./
RUN pip install -e .

# Non-root user (LO2: least privilege)
RUN useradd --create-home --shell /bin/bash detector && \
    mkdir -p /app/models /app/data && \
    chown -R detector:detector /app
USER detector

EXPOSE 8000
CMD ["uvicorn", "anomaly_detector.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
